generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Perfis de acesso possíveis (mantido como String em vez de "enum" do Prisma
// para não exigir migration de dados; a validação dos valores permitidos é
// feita em código, em src/lib/permissions.ts).
// Valores válidos: ADMINISTRADOR | GESTOR | ANALISTA | USUARIO | CLIENTE

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  memberships  Membership[]
  activityLogs ActivityLog[]
  resetTokens  PasswordReset[]
}

model Company {
  id             String            @id @default(cuid())
  name           String
  cnpj           String            @unique
  inscricaoEstadual String?        // usada no cabeçalho do Livro Fiscal de Apuração (Apuração Fiscal)
  ufDestino      String            @default("PA") // UF do estabelecimento, usada como destino no cálculo do DIFAL
  aliquotaInterna Float            @default(0.19) // alíquota interna de ICMS do estado (ufDestino)
  protheusSufixo String?           // sufixo das tabelas desta empresa no Protheus (ex: "140"), valida ^[0-9]{2,4}$
  createdAt      DateTime          @default(now())
  memberships    Membership[]
  spedFiles      SpedFile[]
  icmsApuracoes  IcmsApuracao[]
  difalApuracoes DifalApuracao[]
  conciliacoes   ConciliacaoApuracao[]
  conciliacoesBancarias ConciliacaoBancariaApuracao[]
  auditoriasRtc  AuditorRtcApuracao[]
  activityLog    ActivityLog[]
  perfisProdutos PerfilProduto[]
  validacoesCadastro ValidacaoCadastroApuracao[]
  analisesFiscais AnaliseFiscalApuracao[]
  analiseFiscalTesConfig AnaliseFiscalTesConfig[]
  analiseFiscalCnpjsGrupo AnaliseFiscalCnpjGrupo[]
  analisesFiscaisSaida AnaliseFiscalSaidaApuracao[]
  apuracoesFiscaisIcms AnaliseFiscalApuracaoIcms[]
}

// Vinculo N:N entre usuario e empresa, com papel (role) especifico por empresa.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SpedFile {
  id          String   @id @default(cuid())
  companyId   String
  fileName    String
  competencia String?
  totalLinhas Int
  blocksJson  String // resumo por bloco/registro em JSON
  uploadedAt  DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// Uma "apuração" é o resultado de processar um período (mês) do ICMS
// Antecipado Especial: cruza o relatório de notas de entrada com o relatório
// de pagamentos SEFA do mês, e guarda os totais + cada nota calculada.
model IcmsApuracao {
  id                   String            @id @default(cuid())
  companyId            String
  periodo              String // ex: "05/2026", texto livre informado pelo usuário
  semPagamento         Boolean           @default(false)
  totalNF              Int
  qtdPagas             Int
  qtdPendentes         Int
  valorPago            Float
  valorPendente        Float
  itensConsiderados    Int
  itensDesconsiderados Int
  qtdSemAliquota       Int
  divergencias         Int
  processedAt          DateTime          @default(now())
  company              Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  notas                IcmsNotaApurada[]
}

model IcmsNotaApurada {
  id               String       @id @default(cuid())
  apuracaoId       String
  docFiscal        String
  fornecedor       String?
  cnpj             String?
  uf               String?
  filial           String?
  produto          String?
  ncm              String?
  tes              String?
  chaveNfe         String?
  dataEmissao      DateTime?
  base             Float
  valor            Float // ICMS Antecipado Especial calculado
  status           String // PAGO | PENDENTE
  valorPago        Float?
  dataPagamento    DateTime?
  divergencia      Float?
  itensSemAliquota Int          @default(0)
  apuracao         IcmsApuracao @relation(fields: [apuracaoId], references: [id], onDelete: Cascade)
}

// Apuração do DIFAL (Diferencial de Alíquota), calculada a partir do
// relatório de entradas (mesmo layout do relatório "NF-e de Entrada e Saída").
// Método "por dentro", conforme Convênio ICMS 236/2021 — validado com dados
// reais fornecidos pelo cliente.
model DifalApuracao {
  id                String      @id @default(cuid())
  companyId         String
  periodo           String // ex: "01/2026"
  ufDestino         String
  aliquotaInterna   Float
  totalItens        Int
  itensComDifal     Int
  itensSemDados     Int // itens com dados insuficientes para calcular (inconsistências)
  valorTotalDifal   Float
  processedAt       DateTime    @default(now())
  company           Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  itens             DifalItem[]
}

model DifalItem {
  id              String        @id @default(cuid())
  apuracaoId      String
  docFiscal       String
  fornecedor      String?
  cnpj            String?
  ufOrigem        String?
  produto         String?
  ncm             String?
  cfop            String?
  origemCodigo    String?
  dataEmissao     DateTime?
  quantidade      Float?
  valorUnitario   Float?
  frete           Float?
  despesaIpi      Float?
  desconto        Float?
  valorTotal      Float
  aliqInterestadual Float?
  valorOrigem     Float?
  baseIcms        Float?
  icmsDestino     Float?
  valorDifal      Float?
  inconsistencia  String? // motivo pelo qual não foi possível calcular, se aplicável
  apuracao        DifalApuracao @relation(fields: [apuracaoId], references: [id], onDelete: Cascade)
}

// Conciliação Contábil: compara o Balancete (saldos por conta) com o Razão
// (lançamentos individuais) de um período, identificando divergências,
// duplicidades e lançamentos fora do padrão — sem uso de IA, só regras
// determinísticas, por pedido do cliente.
model ConciliacaoApuracao {
  id                  String              @id @default(cuid())
  companyId           String
  periodo             String // ex: "06/2026"
  modoAnalise         String   @default("BALANCETE") // BALANCETE (todas as contas) | CONTA_ESPECIFICA (só as contas do Razão importado)
  contasAnalisadas    String? // lista de contas quando modoAnalise = CONTA_ESPECIFICA, separadas por vírgula
  totalContas         Int
  contasConciliadas   Int
  contasDivergentes   Int
  valorTotalDiferenca Float
  processedAt         DateTime            @default(now())
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contas              ConciliacaoConta[]
}

model ConciliacaoConta {
  id                  String                @id @default(cuid())
  apuracaoId          String
  conta               String
  descricao           String?
  saldoInicial         Float
  debitoBalancete     Float
  creditoBalancete    Float
  saldoFinalBalancete Float
  debitoRazao         Float
  creditoRazao        Float
  saldoCalculado      Float
  diferencaSaldo      Float
  diferencaDebito     Float
  diferencaCredito    Float
  status              String // CONCILIADA | PENDENTE
  semMovimentacao     Boolean               @default(false)
  mesesSemMovimentacao Int                  @default(0) // períodos consecutivos anteriores também sem movimento
  extratoSaldoFinal   Float? // saldo final do extrato bancário importado, quando aplicável
  extratoDiferenca    Float? // diferença entre saldo calculado e saldo do extrato
  observacoes         String? // texto com os alertas encontrados, separados por ;
  apuracao            ConciliacaoApuracao   @relation(fields: [apuracaoId], references: [id], onDelete: Cascade)
  lancamentos         ConciliacaoLancamento[]
}

// Guarda apenas os lançamentos do Razão que geraram algum alerta (duplicado,
// sem histórico, fora do padrão, possivelmente de outra conta, sem
// correspondência no extrato bancário) — não todos os lançamentos, para
// manter o banco leve.
model ConciliacaoLancamento {
  id           String            @id @default(cuid())
  contaId      String
  data         DateTime?
  historico    String?
  debito       Float
  credito      Float
  tipoAlerta   String // DUPLICADO | SEM_HISTORICO | FORA_DO_PADRAO | OUTRA_CONTA | SALDO_INVERTIDO | SEM_EXTRATO
  conta        ConciliacaoConta  @relation(fields: [contaId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  companyId String?
  action    String
  details   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
}

// Conciliação bancária: Razão da conta Banco x Extrato Bancário, com
// comparação de saldo dia a dia e pareamento inteligente de lançamentos
// (incluindo agrupamentos N:1 e 1:N) — sem IA, só regras determinísticas.
model ConciliacaoBancariaApuracao {
  id                  String                      @id @default(cuid())
  companyId           String
  periodo             String
  contaRazao          String?
  saldoInicial        Float
  saldoFinalRazao     Float
  saldoFinalExtrato   Float
  diferencaSaldoFinal Float
  totalRazao          Int
  totalExtrato        Int
  totalConciliados    Int
  totalPendentes      Int
  valorPendenteRazao  Float
  valorPendenteExtrato Float
  totalEntradaRazao   Float                       @default(0)
  totalSaidaRazao     Float                       @default(0)
  totalEntradaExtrato Float                       @default(0)
  totalSaidaExtrato   Float                       @default(0)
  aplicacaoAutomaticaIncluida Boolean             @default(false)
  processedAt         DateTime                    @default(now())
  company             Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dias                ConciliacaoBancariaDia[]
  itens               ConciliacaoBancariaItem[]
}

// Comparação da movimentação diária (total de entrada/saída por dia,
// Razão x Extrato) — não usa saldo corrente, que é cumulativo e propaga
// divergência de um dia pendente para todos os dias seguintes.
model ConciliacaoBancariaDia {
  id               String                       @id @default(cuid())
  apuracaoId       String
  data             DateTime
  entradaRazao     Float                        @default(0)
  saidaRazao       Float                        @default(0)
  entradaExtrato   Float                        @default(0)
  saidaExtrato     Float                        @default(0)
  diferencaEntrada Float                        @default(0)
  diferencaSaida   Float                        @default(0)
  apuracao         ConciliacaoBancariaApuracao  @relation(fields: [apuracaoId], references: [id], onDelete: Cascade)
}

model ConciliacaoBancariaItem {
  id          String                       @id @default(cuid())
  apuracaoId  String
  origem      String // RAZAO | EXTRATO
  data        DateTime?
  historico   String?
  valor       Float
  status      String // CONCILIADO | CONCILIADO_GRUPO | DIF_COMPETENCIA | APLICACAO_AUTOMATICA | PENDENTE
  grupoRef    String? // liga lançamentos que foram conciliados em grupo (N:1 ou 1:N)
  duplicadoSuspeito Boolean @default(false)
  observacao  String?
  apuracao    ConciliacaoBancariaApuracao  @relation(fields: [apuracaoId], references: [id], onDelete: Cascade)
}

// Auditor RTC: valida XMLs de NF-e quanto aos grupos IBS/CBS da Reforma
// Tributária (NT 2025.002). O XML é processado inteiramente no navegador —
// só o resultado calculado (não o XML bruto) é enviado para persistência.
model AuditorRtcApuracao {
  id                String            @id @default(cuid())
  companyId         String
  periodo           String?
  totalNfes         Int
  totalItens        Int
  canceladas        Int
  denegadas         Int
  validas           Int
  comAlertas        Int
  inconsistentes    Int
  pctConformidade   Float
  semIBS            Int
  semCBS            Int
  arquivosComErro   Int               @default(0)
  processedAt       DateTime          @default(now())
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nfes              AuditorRtcNfe[]
}

model AuditorRtcNfe {
  id             String              @id @default(cuid())
  apuracaoId     String
  fileName       String
  chave          String?
  nNF            String?
  serie          String?
  dhEmi          String?
  cnpjEmit       String?
  xNomeEmit      String?
  status         String // Autorizada | Cancelada | Denegada | Outro | Sem protocolo
  statusDetail   String?
  situacao       String // Válido | Válido com alertas | Inconsistente | Cancelada | Denegada
  itemCount      Int
  itensErro      Int      @default(0)
  itensAlerta    Int      @default(0)
  itensSemIBS    Int      @default(0)
  itensSemCBS    Int      @default(0)
  observacoes    String?
  dadosAdicionais String? // conteúdo de infAdic/infCpl do XML (Informações Complementares de interesse do Contribuinte)
  nProt          String?
  synthetic      Boolean  @default(false)
  apuracao       AuditorRtcApuracao  @relation(fields: [apuracaoId], references: [id], onDelete: Cascade)
  itens          AuditorRtcItem[]
}

model AuditorRtcItem {
  id            String        @id @default(cuid())
  nfeId         String
  nItem         String?
  xProd         String?
  cProd         String?
  ncm           String?
  cfop          String?
  tes           String?
  cClassTrib    String?
  cst           String?
  groupType     String?
  qCom          Float?
  vUnCom        Float?
  vProd         Float?
  vDesc         Float?
  vFrete        Float?
  vSeg          Float?
  vOutro        Float?
  vBC           Float?
  pIBSUF        Float?
  vIBSUF        Float?
  pIBSMun       Float?
  vIBSMun       Float?
  pIBSTotal     Float?
  vIBS          Float?
  pCBS          Float?
  vCBS          Float?
  hasIBS        Boolean       @default(false)
  hasCBS        Boolean       @default(false)
  cstPis        String?
  pPis          Float?
  vPis          Float?
  cstCofins     String?
  pCofins       Float?
  vCofins       Float?
  situacao      String
  missingLabel  String?
  alertLabel    String?
  nfe           AuditorRtcNfe @relation(fields: [nfeId], references: [id], onDelete: Cascade)
}

// Perfil de Produto: classificação tributária de referência (ex: "Produtos Isentos",
// "Combustíveis") cadastrada previamente, contendo a lista de códigos de produto
// que pertencem a ela — usada para auditar o cadastro de produtos da empresa.
model PerfilProduto {
  id        String              @id @default(cuid())
  companyId String
  nome      String
  descricao String?
  createdAt DateTime            @default(now())
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  itens     PerfilProdutoItem[]

  @@unique([companyId, nome])
}

model PerfilProdutoItem {
  id        String        @id @default(cuid())
  perfilId  String
  codigo    String
  descricao String?
  perfil    PerfilProduto @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@unique([perfilId, codigo])
}

// Status possíveis de ValidacaoCadastroItem.status:
// OK | DIVERGENTE | SEM_PERFIL | DUPLICADO
model ValidacaoCadastroApuracao {
  id              String                  @id @default(cuid())
  companyId       String
  periodo         String?
  totalItens      Int
  totalOk         Int
  totalDivergente Int
  totalSemPerfil  Int
  totalDuplicado  Int
  processedAt     DateTime                @default(now())
  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  itens           ValidacaoCadastroItem[]
}

model ValidacaoCadastroItem {
  id                String                    @id @default(cuid())
  apuracaoId        String
  codigo            String
  descricao         String?
  perfilAtual       String?
  perfilEncontrado  String?
  perfisEncontrados String?
  status            String
  observacao        String?
  apuracao          ValidacaoCadastroApuracao @relation(fields: [apuracaoId], references: [id], onDelete: Cascade)
}

// Análise e Apuração Fiscal — auditoria do Relatório Fiscal de Entradas,
// cruzando TES x Produto x CFOP x UF x Fornecedor x Chave NF x tributos.
// status: PROCESSANDO | CONCLUIDA — igual AnaliseFiscalSaidaApuracao:
// arquivos de Entradas também passaram a estourar o limite de payload da
// Vercel quando enviados inteiros (~5MB+), então o cálculo roda no
// navegador e os itens chegam em lotes via /apurar/lote.
model AnaliseFiscalApuracao {
  id                       String   @id @default(cuid())
  companyId                String
  periodo                  String?
  fileName                 String?
  status                   String   @default("PROCESSANDO")
  totalLinhas              Int
  totalNotas               Int
  totalProdutos            Int
  totalTes                 Int
  totalCfops               Int
  qtdTesNovas              Int      @default(0)
  qtdCfopsNovos            Int      @default(0)
  qtdNotasSemChave         Int      @default(0)
  qtdDivergenciaCfopUf     Int      @default(0)
  qtdDivergenciaIcms       Int      @default(0)
  qtdDivergenciaPisCofins  Int      @default(0)
  qtdProdutosIncompativeis Int      @default(0)
  totalDivergencias        Int      @default(0)
  qtdCritico               Int      @default(0)
  qtdAlto                  Int      @default(0)
  qtdMedio                 Int      @default(0)
  qtdBaixo                 Int      @default(0)
  qtdInformativo           Int      @default(0)
  tesNovasEncontradas      String? // lista separada por vírgula, para exibição rápida sem consultar os itens
  processedAt              DateTime @default(now())
  company                  Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  itens                    AnaliseFiscalItem[]
  divergencias              AnaliseFiscalDivergencia[]
  apuracoesIcms            AnaliseFiscalApuracaoIcms[]
}

model AnaliseFiscalItem {
  id               String   @id @default(cuid())
  apuracaoId       String
  linha            Int // nº da linha no arquivo original importado, para rastreio
  tes              String
  tesConhecida     Boolean  @default(false)
  produtoCodigo    String?
  produtoDescricao String?
  cfop             String?
  uf               String?
  fornecedor       String?
  cnpjCpf          String?
  chaveNf          String?
  numeroNf         String?
  total            Float?
  desconto         Float?
  frete            Float?
  despesa          Float?
  seguro           Float?
  valorContabil    Float?
  baseIcms         Float?
  valorIcms        Float?
  aliquotaIcms     Float?
  isento           Float?
  baseOutros       Float?
  basePis          Float?
  valorPis         Float?
  aliquotaPis      Float?
  baseCofins       Float?
  valorCofins      Float?
  aliquotaCofins   Float?
  apuracao         AnaliseFiscalApuracao      @relation(fields: [apuracaoId], references: [id], onDelete: Cascade)
  divergencias     AnaliseFiscalDivergencia[]
}

// severidade: CRITICO | ALTO | MEDIO | BAIXO | INFORMATIVO
model AnaliseFiscalDivergencia {
  id                   String   @id @default(cuid())
  apuracaoId           String // denormalizado — permite consultar a tela de divergências sem join pelo item
  itemId               String
  severidade           String
  tipo                 String
  regraEsperada        String
  informacaoEncontrada String
  motivo               String
  sugestaoCorrecao     String?
  apuracao             AnaliseFiscalApuracao @relation(fields: [apuracaoId], references: [id], onDelete: Cascade)
  item                 AnaliseFiscalItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

// Análise e Apuração Fiscal — Saídas (vendas/transferências/baixas).
// Mesma forma do trio de Entradas acima, mas processada em lotes: o
// Relatório de Saídas real chega a dezenas de milhares de linhas (bem
// maior que Entradas), então o cálculo roda no navegador e os itens são
// persistidos aos poucos via /apurar/lote — daí o campo `status`
// (PROCESSANDO enquanto os lotes ainda estão chegando, CONCLUIDA quando
// /apurar/finalizar termina). O resumo já vem pronto do cálculo no
// navegador (não depende de agregação SQL depois de persistir).
// status: PROCESSANDO | CONCLUIDA
model AnaliseFiscalSaidaApuracao {
  id                       String   @id @default(cuid())
  companyId                String
  periodo                  String?
  fileName                 String?
  status                   String   @default("PROCESSANDO")
  totalLinhas              Int
  totalNotas               Int
  totalProdutos            Int
  totalTes                 Int
  totalCfops               Int
  qtdTesNovas              Int      @default(0)
  qtdCfopsNovos            Int      @default(0)
  qtdNotasSemChave         Int      @default(0)
  qtdDivergenciaCfopUf     Int      @default(0)
  qtdDivergenciaIcms       Int      @default(0)
  qtdDivergenciaPisCofins  Int      @default(0)
  qtdProdutosIncompativeis Int      @default(0)
  totalDivergencias        Int      @default(0)
  qtdCritico               Int      @default(0)
  qtdAlto                  Int      @default(0)
  qtdMedio                 Int      @default(0)
  qtdBaixo                 Int      @default(0)
  qtdInformativo           Int      @default(0)
  tesNovasEncontradas      String?
  processedAt              DateTime @default(now())
  company                  Company                         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  itens                    AnaliseFiscalSaidaItem[]
  divergencias             AnaliseFiscalSaidaDivergencia[]
  apuracoesIcms            AnaliseFiscalApuracaoIcms[]
}

model AnaliseFiscalSaidaItem {
  id               String   @id @default(cuid())
  apuracaoId       String
  linha            Int
  tes              String
  tesConhecida     Boolean  @default(false)
  produtoCodigo    String?
  produtoDescricao String?
  cfop             String?
  uf               String?
  cliente          String?
  cnpjCpf          String?
  chaveNf          String?
  numeroNf         String?
  total            Float?
  desconto         Float?
  frete            Float?
  despesa          Float?
  seguro           Float?
  valorContabil    Float?
  baseIcms         Float?
  valorIcms        Float?
  aliquotaIcms     Float?
  isento           Float?
  baseOutros       Float?
  basePis          Float?
  valorPis         Float?
  aliquotaPis      Float?
  baseCofins       Float?
  valorCofins      Float?
  aliquotaCofins   Float?
  apuracao         AnaliseFiscalSaidaApuracao      @relation(fields: [apuracaoId], references: [id], onDelete: Cascade)
  divergencias     AnaliseFiscalSaidaDivergencia[]

  @@index([apuracaoId])
}

// severidade: CRITICO | ALTO | MEDIO | BAIXO | INFORMATIVO
model AnaliseFiscalSaidaDivergencia {
  id                   String   @id @default(cuid())
  apuracaoId           String
  itemId               String
  severidade           String
  tipo                 String
  regraEsperada        String
  informacaoEncontrada String
  motivo               String
  sugestaoCorrecao     String?
  apuracao             AnaliseFiscalSaidaApuracao @relation(fields: [apuracaoId], references: [id], onDelete: Cascade)
  item                 AnaliseFiscalSaidaItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([apuracaoId])
}

// Metadados de TES editáveis por empresa (chaveNf, permiteProdutos, rótulo)
// — a lógica de regras profundas continua fixa no código
// (analise-fiscal-tes-registry.ts); isto é só a classificação básica que
// permite cadastrar uma "TES nova" sem precisar de deploy.
// chaveNf: obrigatoria | proibida | livre
model AnaliseFiscalTesConfig {
  id              String   @id @default(cuid())
  companyId       String
  codigo          String
  grupo           String
  chaveNf         String
  permiteProdutos Boolean  @default(true)
  validarCfopUf   Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, codigo])
}

// CNPJs do grupo de empresas relacionadas, usados pela TES de
// transferência entre filiais (138) para validar o fornecedor/remetente.
model AnaliseFiscalCnpjGrupo {
  id        String   @id @default(cuid())
  companyId String
  nome      String
  cnpj      String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, cnpj])
}

// Apuração Fiscal (Livro de Apuração do ICMS) — terceira seção de
// "Análise e Apuração Fiscal". Não duplica dado fiscal: só guarda o
// vínculo com a Entrada/Saída já processadas (para recalcular os totais
// por CFOP ao vivo, via groupBy sobre AnaliseFiscalItem/
// AnaliseFiscalSaidaItem) mais os lançamentos manuais e o saldo credor
// anterior — os únicos dados que não existem em lugar nenhum do sistema.
model AnaliseFiscalApuracaoIcms {
  id                  String   @id @default(cuid())
  companyId           String
  periodo             String
  entradaApuracaoId   String?
  saidaApuracaoId     String?
  saldoCredorAnterior Float    @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  company             Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entradaApuracao     AnaliseFiscalApuracao?      @relation(fields: [entradaApuracaoId], references: [id], onDelete: SetNull)
  saidaApuracao       AnaliseFiscalSaidaApuracao? @relation(fields: [saidaApuracaoId], references: [id], onDelete: SetNull)
  lancamentos         AnaliseFiscalApuracaoIcmsLancamento[]
}

// Lançamentos manuais do Resumo da Apuração (itens 002/003/006/007/012
// do Livro Fiscal real). categoria: OUTROS_DEBITOS | ESTORNO_CREDITOS |
// OUTROS_CREDITOS | ESTORNO_DEBITOS | DEDUCOES
model AnaliseFiscalApuracaoIcmsLancamento {
  id          String   @id @default(cuid())
  apuracaoId  String
  categoria   String
  descricao   String
  valor       Float    @default(0)
  ordem       Int      @default(0)
  apuracao    AnaliseFiscalApuracaoIcms @relation(fields: [apuracaoId], references: [id], onDelete: Cascade)

  @@index([apuracaoId])
}
